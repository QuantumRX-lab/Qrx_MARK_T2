          <BinaryString name="AttributesSerialize">BwAAAAsAAABCYXJDYXBhY2l0eQYAAAAAAAB5QAkAAABCYXNlU3BlZWQGAAAAAAAAPEAIAAAAQmFzZVR1cm4GAAAAAABAekAPAAAATW91dGhBcmNEZWdyZWVzBgAAAAAAgFtABQAAAFBvd2VyBgAAAAAA4IVABAAAAFRpZXIGAAAAAAAAEEANAAAAVHJpYW5nbGVDb3VudAYAAAAAAEBxQA==</BinaryString>
          <bool name="NeedsPivotMigration">false</bool>
          <Ref name="PrimaryPart">9</Ref>
          <BinaryString name="Tags">Q2hvbXBfVmVoaWNsZQ==</BinaryString>
        </Properties>
        <Item class="Part" referent="9">
          <Properties>
            <string name="Name">Chassis</string>
            <bool name="Anchored">false</bool>
            <CoordinateFrame name="CFrame">
              <X>0</X>
              <Y>0.2</Y>
              <Z>0</Z>
              <R00>1</R00>
              <R01>0</R01>
              <R02>0</R02>
              <R10>0</R10>
              <R11>1</R11>
              <R12>0</R12>
              <R20>0</R20>
              <R21>0</R21>
              <R22>1</R22>
            </CoordinateFrame>
            <bool name="CanCollide">true</bool>
            <bool name="CanQuery">true</bool>
            <bool name="CanTouch">true</bool>
            <Color3uint8 name="Color3uint8">1317407</Color3uint8>
            <bool name="Massless">false</bool>
            <CoordinateFrame name="PivotOffset">
              <X>0</X>
              <Y>-0.2</Y>
              <Z>0</Z>
